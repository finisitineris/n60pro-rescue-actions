config dnsmasq
        option domainneeded '1'
        option boguspriv '1'
        option localise_queries '1'
        option local '/lan/'
        option domain 'lan'
        option expandhosts '1'
        option authoritative '1'
        option readethers '1'
        option leasefile '/tmp/dhcp.leases'
        option noresolv '1'
        option localservice '1'
        option nonwildcard '1'
        list interface 'lan'

config dhcp 'lan'
        option interface 'lan'
        option start '100'
        option limit '20'
        option leasetime '1h'
        option force '1'
